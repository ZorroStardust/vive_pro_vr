bash -lc "
export XR_RUNTIME_JSON=/usr/share/openx
r/1/openxr_monado.json
export XDG_RUNTIME_DIR=/run/user/1000
unset DISPLAY
unset WAYLAND_DISPLAY

echo '[hello] help:'
hello_xr -h 2>&1 || true

HELLO_ARGS='-g Vulkan'
if hello_xr -h 2>&1 | grep -q -- '-f';
then
  HELLO_ARGS='-g Vulkan -f Hmd'
fi

echo '[hello] running: hello_xr' $HELLO
_ARGS
env XR_LOADER_DEBUG=all stdbuf -oL -eL
timeout --foreground 90s hello_xr $HELL
O_ARGS
echo '[hello] exit status:' $?
"
