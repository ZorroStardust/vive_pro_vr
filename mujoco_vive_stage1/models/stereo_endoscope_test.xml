<mujoco model="stereo_endoscope_test">
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="20"/>
    <global offwidth="1440" offheight="1600"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             width="512" height="512"
             rgb1="0.18 0.18 0.18"
             rgb2="0.70 0.70 0.70"/>
    <material name="gridmat" texture="grid" texrepeat="8 8" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="key" pos="0 -1 3" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <light name="fill" pos="-1 -1 1.5" dir="1 1 -1" diffuse="0.3 0.3 0.3"/>

    <geom name="floor" type="plane" pos="0 0 0" size="3 3 0.01" material="gridmat"/>

    <geom name="near_red_box" type="box" pos="-0.18 0.45 0.18" size="0.08 0.08 0.08"
          rgba="0.9 0.18 0.14 1"/>
    <geom name="far_blue_sphere" type="sphere" pos="0.22 0.95 0.24" size="0.10"
          rgba="0.15 0.25 0.95 1"/>
    <geom name="center_green_capsule" type="capsule" fromto="0.0 0.55 0.12  0.0 0.85 0.12"
          size="0.045" rgba="0.10 0.85 0.24 1"/>

    <body name="spinning_box" pos="0 0.70 0.38">
      <joint name="spin" type="hinge" axis="0 0 1" damping="0.1"/>
      <geom type="box" size="0.16 0.04 0.08" rgba="1.0 0.65 0.10 1"/>
    </body>

    <!--
      Camera looks along local -Z. xyaxes sets image +X and image +Y.
      Here local -Z points roughly world +Y, so the cameras look from y=-1
      toward the scene.
    -->
    <body name="endoscope_tip" pos="0 -1.0 0.35">
      <geom name="tip_marker" type="sphere" size="0.025" rgba="1 1 1 1"/>

      <camera name="endo_left"
              pos="-0.0003 0 0"
              xyaxes="1 0 0  0 0 1"
              fovy="55"/>

      <camera name="endo_right"
              pos="0.0003 0 0"
              xyaxes="1 0 0  0 0 1"
              fovy="55"/>
    </body>
  </worldbody>
</mujoco>
